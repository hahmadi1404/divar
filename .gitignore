```gitignore
# Build artifacts
*.exe
*.dll
*.pdb
*.user
*.suo
*.cache
*.manifest
bin/
obj/
Debug/
Release/

# Dependencies
packages/
node_modules/
.nuget/
.npm/

# Logs and temp files
*.log
*.tmp
*.temp

# Environment
.env
.env.local
*.env.*

# Editors
.vs/
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Testing
TestResults/
coverage/
```